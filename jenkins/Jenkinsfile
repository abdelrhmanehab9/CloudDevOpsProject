@Library('shared-library') _

pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = "docker.io"
        DOCKER_USERNAME = "abdelrhmanehab11"
        IMAGE_NAME = "abdelrhmanehab11/test"
        IMAGE_TAG = "${BUILD_NUMBER}"
        GIT_REPO = "https://github.com/abdelrhmanehab9/CloudDevOpsProject.git"
        GIT_BRANCH = "main"
        MANIFEST_DIR = "kubernetes/manifests"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 1, unit: 'HOURS')
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    echo "🔄 Checking out code from Git..."
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${GIT_BRANCH}"]],
                        userRemoteConfigs: [[url: "${GIT_REPO}"]]
                    ])
                }
            }
        }

        // Prevents an endless build loop: this pipeline pushes updated manifests
        // to the same repo, so builds triggered by that commit must be skipped.
        stage('Loop Guard') {
            steps {
                script {
                    def author = sh(script: 'git log -1 --pretty=%an', returnStdout: true).trim()
                    if (author == 'Jenkins CI') {
                        env.SKIP_BUILD = 'true'
                        currentBuild.description = 'Skipped: last commit was made by Jenkins CI'
                        echo "⏭️ Last commit was made by Jenkins CI, skipping to avoid a build loop."
                    } else {
                        env.SKIP_BUILD = 'false'
                    }
                }
            }
        }

        stage('Build Image') {
            when { expression { env.SKIP_BUILD != 'true' } }
            steps {
                script {
                    echo "🐋 Building Docker image..."
                    buildImage(
                        imageName: "${IMAGE_NAME}",
                        imageTag: "${IMAGE_TAG}",
                        dockerfile: "docker/Dockerfile",
                        context: "docker"
                    )
                }
            }
        }

        stage('Scan Image') {
            when { expression { env.SKIP_BUILD != 'true' } }
            steps {
                script {
                    echo "🔍 Scanning Docker image with Trivy..."
                    scanImage(
                        imageName: "${IMAGE_NAME}",
                        imageTag: "${IMAGE_TAG}",
                        severity: "HIGH,CRITICAL"
                    )
                }
            }
        }

        stage('Push Image') {
            when { expression { env.SKIP_BUILD != 'true' } }
            steps {
                script {
                    echo "📤 Pushing image to DockerHub..."
                    withCredentials([usernamePassword(credentialsId: 'Dockerhub', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh """
                            echo "\${DOCKER_PASS}" | docker login ${DOCKER_REGISTRY} -u "\${DOCKER_USER}" --password-stdin
                        """
                        pushImage(
                            imageName: "${IMAGE_NAME}",
                            imageTag: "${IMAGE_TAG}"
                        )
                        sh "docker logout ${DOCKER_REGISTRY}"
                    }
                }
            }
        }

        stage('Delete Local Image') {
            when { expression { env.SKIP_BUILD != 'true' } }
            steps {
                script {
                    echo "🗑️ Deleting local Docker image..."
                    sh """
                        docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true
                        docker rmi ${IMAGE_NAME}:latest || true
                        echo "✅ Local images deleted"
                    """
                }
            }
        }

        stage('Update Manifests') {
            when { expression { env.SKIP_BUILD != 'true' } }
            steps {
                script {
                    echo "📝 Updating Kubernetes manifests with new image..."
                    updateManifests(
                        manifestDir: "${MANIFEST_DIR}",
                        imageName: "${IMAGE_NAME}",
                        imageTag: "${IMAGE_TAG}"
                    )
                }
            }
        }

        stage('Commit & Push Manifests') {
            when { expression { env.SKIP_BUILD != 'true' } }
            steps {
                script {
                    echo "📤 Committing and pushing updated manifests..."
                    withCredentials([usernamePassword(credentialsId: 'Github', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
                        // Single quotes: the shell reads the secrets from env vars,
                        // so they are never interpolated by Groovy.
                        sh '''
                            git config user.name "Jenkins CI"
                            git config user.email "jenkins@clouddevops.local"
                            git add "${MANIFEST_DIR}"
                            git commit -m "Update image to ${IMAGE_NAME}:${IMAGE_TAG} [Build #${BUILD_NUMBER}]" || echo "No changes to commit"
                            git push "https://${GIT_USER}:${GIT_PASS}@github.com/abdelrhmanehab9/CloudDevOpsProject.git" HEAD:main
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                node {
                    echo "🧹 Cleanup and archiving artifacts..."
                    cleanWs()
                }
            }
        }

        success {
            script {
                if (env.SKIP_BUILD == 'true') {
                    echo "⏭️ Build skipped (commit made by Jenkins CI)."
                } else {
                    echo "✅ Pipeline succeeded! Image ${IMAGE_NAME}:${IMAGE_TAG} deployed successfully!"
                }
            }
        }

        failure {
            echo "❌ Pipeline failed! Check logs for details."
        }
    }
}
